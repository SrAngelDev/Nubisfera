{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/*",
          "/**/*.json"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**",
          "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/**",
          "https://cdnjs.cloudflare.com/ajax/libs/weather-icons/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-openmeteo",
      "urls": [
        "https://api.open-meteo.com/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30m",
        "strategy": "freshness",
        "timeout": "10s"
      }
    }
  ]
}
